# Zona horaria
TZ=UTC

# Red Docker compartida con Nivel Pro
DOCKER_NETWORK=saas-network

# PostgreSQL: nombre DNS del servicio en la red compartida
PGHOST=postgres
PGPORT=5432
PGUSER=backup_user
PGPASSWORD=CAMBIAR_PASSWORD

# Patrón de nombres de bases de clientes
DB_INCLUDE_REGEX=^empresa_

# Cifrado: clave pública age (age1...)
AGE_RECIPIENT=age1CAMBIAR_POR_TU_CLAVE_PUBLICA

# Google Drive
RCLONE_REMOTE=gdrive:
REMOTE_BASE=SaaS-Backups

# Retención
LOCAL_RETENTION_DAYS=7
DAILY_RETENTION_DAYS=35
MONTHLY_RETENTION_DAYS=365
